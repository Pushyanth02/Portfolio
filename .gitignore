# ─────────────────────────────────────────────────────────────
# pushyanth-portfolio · Node / Next.js / Bun gitignore
# See https://git-scm.com/docs/gitignore and
# https://help.github.com/articles/ignoring-files/ for syntax.
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build artifacts
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Bun — binary lockfile (legacy format) is never committed.
# The text `bun.lock` IS tracked so CI installs stay deterministic.
bun.lockb

# Logs
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
# (.env currently holds only a local DATABASE_URL — no secrets —
# but environment config never belongs in a public repo)
.env
.env*.local

# Tests & coverage
coverage/

# Secrets / certs
*.pem

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/

# Vercel local artifacts
.vercel

# NOTE: `.vscode/` is intentionally NOT ignored — the workspace
# settings and extension recommendations are shared with the team.

# ─────────────────────────────────────────────────────────────
# Sandbox-only working folders — used while developing this
# project inside the build sandbox; they are NOT part of the
# shipped repository:
#   db            local SQLite database (contact-form dev inbox)
#   upload        uploaded sources, screenshots, verification captures
#   download      export staging
#   tool-results  tool output captures
#   scripts       one-off VLM verification scripts
#   tests         sandbox runtime probe scripts
#   examples      sandbox example code
# ─────────────────────────────────────────────────────────────
/db/
/upload/
/download/
/tool-results/
/scripts/
/tests/
/examples/
/mini-services/
/skills/
/.zscripts/
